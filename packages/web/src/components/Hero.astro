---
---

<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-content">
    <div class="badge">🚀 Open Source CLI Tool</div>
    <h1>
      The ultimate interactive
      <span class="gradient-text">npm dependency updater</span>
    </h1>
    <p class="subtitle">
      Auto-detect outdated packages, view breaking changes, and update
      with a vibrant CLI experience. Smart, safe, and beautiful.
    </p>
    <div class="hero-actions">
      <a href="#usage" class="btn btn-primary">Get Started</a>
      <a
        href="https://github.com/jorgeadev/updeps"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline"
      >
        View on GitHub
      </a>
    </div>
    <div class="install-command">
      <code>npx updeps</code>
      <span class="install-hint">Run it directly — no install needed</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6rem 2rem 4rem;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 30% 20%, rgba(124, 58, 237, 0.15) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 80%, rgba(6, 182, 212, 0.1) 0%, transparent 50%),
      radial-gradient(ellipse at 50% 50%, rgba(16, 185, 129, 0.05) 0%, transparent 60%);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    max-width: 720px;
  }

  .badge {
    display: inline-block;
    padding: 0.35rem 1rem;
    background: rgba(124, 58, 237, 0.15);
    border: 1px solid rgba(124, 58, 237, 0.3);
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-primary);
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary), var(--color-success));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    max-width: 560px;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.75rem;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    transition: all 0.2s;
    text-decoration: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--color-primary), #6d28d9);
    color: white;
    box-shadow: 0 4px 20px rgba(124, 58, 237, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 30px rgba(124, 58, 237, 0.45);
    color: white;
  }

  .btn-outline {
    border: 1px solid rgba(124, 58, 237, 0.4);
    color: var(--color-text);
    background: transparent;
  }

  .btn-outline:hover {
    background: rgba(124, 58, 237, 0.1);
    border-color: var(--color-primary);
    color: var(--color-text);
  }

  .install-command {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .install-command code {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    padding: 0.6rem 1.5rem;
    background: var(--color-bg-alt);
    border: 1px solid rgba(124, 58, 237, 0.2);
    border-radius: 8px;
    color: var(--color-secondary);
  }

  .install-hint {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
</style>
