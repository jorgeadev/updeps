---
---

<footer>
  <div class="container">
    <div class="footer-content">
      <div class="footer-brand">
        <span class="logo-text">📦 updeps</span>
        <p>The ultimate interactive npm dependency updater.</p>
      </div>
      <div class="footer-links">
        <a href="https://github.com/jorgeadev/updeps" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://www.npmjs.com/package/updeps" target="_blank" rel="noopener noreferrer">npm</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>CC BY-NC 4.0 — <a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="noopener noreferrer">Creative Commons Attribution-NonCommercial 4.0 International</a></p>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid rgba(124, 58, 237, 0.1);
    padding: 3rem 2rem 2rem;
    background: var(--color-bg-alt);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .logo-text {
    font-size: 1.1rem;
    font-weight: 700;
    display: block;
    margin-bottom: 0.5rem;
  }

  .footer-brand p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-links a {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--color-text);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 1.5rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .footer-bottom a {
    color: var(--color-text-muted);
  }

  .footer-bottom a:hover {
    color: var(--color-secondary);
  }
</style>
